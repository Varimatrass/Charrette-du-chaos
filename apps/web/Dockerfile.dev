# Image de dev pour le frontend Angular — sert le serveur de dev avec
# rechargement à chaud. Pas destinée à la prod (le build de prod est un site
# statique, voir README pour le déploiement).
FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /workspace

FROM base AS deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS dev
COPY . .
RUN pnpm --filter @desordre/shared-types run build
EXPOSE 4200
# Voir le commentaire équivalent dans apps/api/Dockerfile.dev : on reconstruit
# shared-types à chaque démarrage à cause du bind mount du docker-compose.
CMD ["sh", "-c", "pnpm --filter @desordre/shared-types run build && pnpm --filter @desordre/web run start -- --host 0.0.0.0 --port 4200"]
