{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Jest (ts-jest) exécute les tests en CommonJS, contrairement au build
    // (nodenext) : on force ce format et une résolution de modules classique.
    "module": "commonjs",
    "moduleResolution": "node10",
    "resolvePackageJsonExports": false,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"]
}
