# Copie ce fichier en .env et remplis les valeurs.

# Chaîne de connexion PostgreSQL.
# - Avec `docker compose up` (tout en conteneurs) : docker-compose.yml
#   écrase cette valeur automatiquement, tu peux laisser celle-ci telle quelle.
# - Avec `docker compose up -d db` + API/web en natif (`pnpm dev:api`) :
#   utilise localhost et le port défini dans le .env racine (5432 par défaut).
# - Sans Docker du tout (Supabase, Neon...) : mets ta vraie chaîne ici.
DATABASE_URL="postgresql://charrette:charrette@localhost:5432/charrette_du_chaos"

# Port d'écoute de l'API NestJS.
PORT=3000

# Origine(s) autorisée(s) pour le CORS (l'URL du frontend Angular en dev/prod),
# séparées par des virgules.
CORS_ORIGINS="http://localhost:4200"

# URL publique du frontend, utilisée pour construire le lien personnel envoyé
# aux paxs (ex: https://navettes.ledesordre.fr).
FRONTEND_URL="http://localhost:4200"

# Clé partagée pour accéder au back-office organisateur·ice (V1 : pas de
# vraie liste de comptes, juste une clé à connaître). Choisis une valeur
# longue et aléatoire, et ne la commite jamais.
ADMIN_KEY="change-moi"
