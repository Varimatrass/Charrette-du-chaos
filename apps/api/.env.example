# Copie ce fichier en .env et remplis les valeurs.

# Chaîne de connexion PostgreSQL (Supabase, Neon, ou une instance locale).
DATABASE_URL="postgresql://user:password@localhost:5432/desordre_navettes"

# Port d'écoute de l'API NestJS.
PORT=3000

# Origine(s) autorisée(s) pour le CORS (l'URL du frontend Angular en dev/prod),
# séparées par des virgules.
CORS_ORIGINS="http://localhost:4200"

# URL publique du frontend, utilisée pour construire le lien personnel envoyé
# aux paxs (ex: https://navettes.ledesordre.fr).
FRONTEND_URL="http://localhost:4200"

# Clé partagée pour accéder au back-office organisateur·ice (V1 : pas de
# vraie liste de comptes, juste une clé à connaître). Choisis une valeur
# longue et aléatoire, et ne la commite jamais.
ADMIN_KEY="change-moi"
