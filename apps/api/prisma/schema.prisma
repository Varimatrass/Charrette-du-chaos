// Schéma Prisma — Le Désordre / Navettes
// Après avoir cloné le projet et renseigné DATABASE_URL dans apps/api/.env,
// lance `pnpm prisma:generate` puis `pnpm prisma:migrate` depuis la racine.

generator client {
  provider = "prisma-client-js"
}

// Depuis Prisma 7, l'URL de connexion ne se met plus ici : elle est lue
// depuis DATABASE_URL par prisma.config.ts (pour le CLI : generate/migrate)
// et par l'adapter passé à PrismaClient dans prisma.service.ts (à l'exécution).
datasource db {
  provider = "postgresql"
}

enum Sens {
  ALLER
  RETOUR
}

enum ModeTransport {
  TRAIN
  COVOITURAGE
  AUTRE
}

enum StatutTrajet {
  EN_ATTENTE
  ASSIGNE
  A_REVERIFIER
}

// Nuance du prêt de véhicule pour les navettes : certain·es pax acceptent de
// prêter leur véhicule uniquement si c'est elleux qui le conduisent (question
// d'assurance), d'autres l'acceptent même si quelqu'un d'autre conduit.
enum VehicleLendingMode {
  NOT_AVAILABLE
  ONLY_IF_OWNER_DRIVES
  AVAILABLE_ANY_DRIVER
}

model Event {
  id            String   @id @default(uuid())
  nom           String
  dateDebut     DateTime @map("date_debut") @db.Date
  dateFin       DateTime @map("date_fin") @db.Date
  lieu          String
  gareReference String   @map("gare_reference")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  paxs                    Pax[]
  navettes                Navette[]
  trajets                 Trajet[]
  driverAvailabilitySlots DriverAvailabilitySlot[]

  @@map("events")
}

model Pax {
  id               String   @id @default(uuid())
  eventId          String   @map("event_id")
  nom              String
  contactEmail     String?  @map("contact_email")
  contactTelephone String?  @map("contact_telephone")
  discordHandle    String?  @map("discord_handle")
  commentaire      String?
  // Bloc véhicule/conduite (parcours d'inscription v2) : tout reste nullable
  // car non renseigné au départ pour les pax existants, et parce que "pas
  // encore répondu" doit rester distinct de "non" pour l'organisation.
  hasVehicle            Boolean?            @map("has_vehicle")
  vehicleLendingMode    VehicleLendingMode? @map("vehicle_lending_mode")
  hasDrivingLicense     Boolean?            @map("has_driving_license")
  willingToDriveShuttle Boolean?            @map("willing_to_drive_shuttle")
  // Jeton d'accès personnel non devinable : c'est ce qui permet à un pax
  // de revenir modifier ses infos sans compte. Ne jamais l'exposer dans les
  // vues publiques/listes, seulement dans la réponse de création et le
  // back-office organisateur·ice.
  accessToken      String   @unique @default(uuid()) @map("access_token")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  event                   Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trajets                 Trajet[]
  driverAvailabilitySlots DriverAvailabilitySlot[]

  @@index([eventId])
  @@map("paxs")
}

model Navette {
  id               String   @id @default(uuid())
  eventId          String   @map("event_id")
  libelle          String
  jour             DateTime @db.Date
  sens             Sens
  conducteur       String?
  vehicule         String?
  heureDepart      String   @map("heure_depart") // "HH:mm"
  heureArriveeGare String   @map("heure_arrivee_gare") // "HH:mm"
  heureRetourLieu  String?  @map("heure_retour_lieu") // "HH:mm"
  capacite         Int
  commentaire      String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trajets Trajet[]

  @@index([eventId])
  @@map("navettes")
}

model Trajet {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  paxId   String @map("pax_id")
  sens    Sens
  // Nullable : à l'inscription, le mode de transport peut être "pas encore
  // décidé" (ex: arrivée en train, retour indécis) — le pax pourra revenir
  // le préciser plus tard, comme le reste du trajet.
  mode        ModeTransport?
  jour        DateTime?     @db.Date
  heure       String? // "HH:mm"
  gare        String?
  navetteId   String?       @map("navette_id")
  statut      StatutTrajet  @default(EN_ATTENTE)
  commentaire String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pax     Pax      @relation(fields: [paxId], references: [id], onDelete: Cascade)
  navette Navette? @relation(fields: [navetteId], references: [id], onDelete: SetNull)

  // Un pax n'a qu'un seul trajet par sens (aller / retour) et par évènement.
  // Il reste librement modifiable, jamais dupliqué.
  @@unique([paxId, sens])
  @@index([eventId])
  @@index([navetteId])
  @@map("trajets")
}

// Créneau où un·e pax ayant accepté de conduire des navettes se déclare
// disponible. Les admins piochent dedans pour créer les navettes avec un·e
// conducteur·ice déjà partant·e, plutôt que de saisir un nom à la main.
model DriverAvailabilitySlot {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  paxId     String   @map("pax_id")
  day       DateTime @db.Date
  startTime String?  @map("start_time") // "HH:mm"
  endTime   String?  @map("end_time") // "HH:mm"
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pax   Pax   @relation(fields: [paxId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([paxId])
  @@map("driver_availability_slots")
}
