# Variables pour docker-compose (la base de données locale).
# Copie ce fichier en .env à la racine. Ce fichier est différent de
# apps/api/.env (clé admin, URL du frontend...), qu'il faut aussi configurer.

POSTGRES_USER=charrette
POSTGRES_PASSWORD=charrette
POSTGRES_DB=charrette_du_chaos
POSTGRES_PORT=5432
